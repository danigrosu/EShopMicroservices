# Copy this file to .env (same folder) and fill in the values.
# docker-compose reads .env automatically; .env is gitignored.

# PostgreSQL (catalogdb, basketdb)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# SQL Server (orderdb) - min 8 chars, upper/lower case, digits/symbols
MSSQL_SA_PASSWORD=

# RabbitMQ (messagebroker)
RABBITMQ_USER=
RABBITMQ_PASSWORD=
